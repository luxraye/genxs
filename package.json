{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:scyther": "vite apps/scyther --port 3002",
    "build:scyther": "vite build apps/scyther",
    "dev:rubric": "vite apps/rubric --port 3003",
    "build:rubric": "vite build apps/rubric",
    "dev:aegis": "vite apps/aegis --port 3004",
    "build:aegis": "vite build apps/aegis",
    "dev:crucible": "vite apps/crucible --port 3005",
    "build:crucible": "vite build apps/crucible",
    "dev:torrent": "vite apps/torrent --port 3006",
    "build:torrent": "vite build apps/torrent",
    "start": "node server.ts",
    "build": "vite build",
    "build:all": "npm run build && npm run build:scyther && npm run build:rubric && npm run build:aegis && npm run build:crucible && npm run build:torrent",
    "deploy:hosting": "npx -p firebase-tools firebase deploy --only hosting",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js apps/*/dist",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.19.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
